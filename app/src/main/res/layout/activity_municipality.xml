<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    tools:context=".Municipality">

    <TextView
        android:id="@+id/municipalityNameTextView"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/municipality_name_placeholder"
        android:textColor="@color/color_text_light"
        android:textSize="24sp"
        android:textStyle="bold"
        android:background="@color/municipality_beijing"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/municipalityImageView"
        android:layout_width="0dp"
        android:layout_height="220dp"
        android:contentDescription="@string/municipality_detail_image_description"
        android:scaleType="centerCrop"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/municipalityNameTextView"
        tools:src="@drawable/beijing" />

    <ScrollView
        android:id="@+id/informationScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toTopOf="@id/visitSiteButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/municipalityImageView">

        <TextView
            android:id="@+id/municipalityInfoTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/municipality_info_placeholder"
            android:textColor="@color/municipality_beijing"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp" />

    </ScrollView>

    <Button
        android:id="@+id/visitSiteButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:text="@string/visit_site"
        android:textAllCaps="false"
        android:textColor="@color/color_text_light"
        app:backgroundTint="@color/municipality_beijing"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>